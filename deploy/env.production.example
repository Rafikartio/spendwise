# ---------- Production (EC2) -> save as server/.env on the server ----------
NODE_ENV=production
PORT=4000
# Your public URL (http://<EC2-IP> until you have a domain + HTTPS)
CLIENT_ORIGIN=https://your-domain.com
TRUST_PROXY=1

# REQUIRED. Generate a NEW one for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=node_user
DB_PASSWORD=
DB_NAME=spendwise_db

ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
