# ---------- Local development ----------
# Copy to server/.env and edit:   cp server/.env.example server/.env
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=node_user
DB_PASSWORD=
DB_NAME=spendwise_db
# DB_SSL=true            # only for managed DBs that require SSL

# First admin: created once on startup if no admin exists yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
